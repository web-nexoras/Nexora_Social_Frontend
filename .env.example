# Base URL for the backend API.
# - Local dev: keep http://localhost:5000/api/v1
# - Vercel: do NOT commit a production URL here. Instead add an Environment Variable
#   named VITE_API_URL in your Vercel project settings pointing at your deployed backend,
#   e.g. https://your-backend-domain.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1
